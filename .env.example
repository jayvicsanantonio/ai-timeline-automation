# Core configuration
OPENAI_API_KEY=sk-your-openai-key
GIT_TOKEN=ghp-your-github-token
TIMELINE_REPO=owner/repo

# Optional overrides
AI_MODEL=gpt-5.0-low
MAX_EVENTS_PER_WEEK=3
SIGNIFICANCE_THRESHOLD=7.0
DRY_RUN=false
LOG_LEVEL=info

# Source domain controls (comma-separated hostnames, optional)
SOURCE_ALLOWLIST=openai.com,anthropic.com,deepmind.com,ai.googleblog.com,blog.google,microsoft.com,blogs.microsoft.com,meta.com,about.fb.com,stability.ai,huggingface.co,arxiv.org,github.com,reuters.com,apnews.com,bloomberg.com,ft.com,wsj.com,nytimes.com,theguardian.com,wired.com,techcrunch.com,semianalysis.com,nature.com,sciencemag.org,ieee.org,acm.org
SOURCE_BLOCKLIST=localhost,127.0.0.1,0.0.0.0,clickbait-news.com

# Optional source-specific keys
HACKERNEWS_API_KEY=
ARXIV_API_KEY=
